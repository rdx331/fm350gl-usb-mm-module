--- a/files/usr/lib/ModemManager/connection.d/10-report-down	2026-09-25 15:55:49.801580316 +0700
+++ b/files/usr/lib/ModemManager/connection.d/10-report-down	2026-09-25 04:12:10.000000000 +0700
@@ -32,8 +32,10 @@
 
 [ "${IFUP}" = "true" ] && {
 	mm_log "info" "Reconnecting '${CFG}' on '${STATE}' event"
-	ubus call network.interface down "{ 'interface': '${CFG}'}"
-	ubus call network.interface up "{ 'interface': '${CFG}'}"
+	# Launched detached (setsid, no inherited fds) so it survives
+	# ModemManager's 5-second kill of this hook - see mm-reconnect-retry
+	# for why a single ifdown/ifup here isn't enough on its own.
+	setsid /usr/sbin/mm-reconnect-retry "${CFG}" </dev/null >/dev/null 2>&1 &
 }
 
 exit 0

