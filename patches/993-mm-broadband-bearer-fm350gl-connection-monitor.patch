+/*
+ * Generic MMBroadbandBearer connection monitoring polls AT+CGACT? and
+ * looks for our own cid in the returned list. If the cid isn't present
+ * at all, the generic code treats that as an unexpected error
+ * ("PDP context not found in the known contexts list") and just logs a
+ * warning every poll, forever - it never reports a disconnection. On
+ * this modem a network-dropped session can disappear from the +CGACT?
+ * list entirely rather than showing up as inactive, so that "shouldn't
+ * happen" case is actually the normal disconnect signal here. This
+ * override treats a missing cid the same as an inactive one.
+ */
+static void
+load_connection_status_ready(MMBaseModem *modem,
+                             GAsyncResult *res,
+                             GTask *task)
+{
+  MMBroadbandBearerFM350GL *self;
+  const gchar *response;
+  GError *error = NULL;
+  GList *pdp_active_list = NULL;
+  GList *l;
+  MMBearerConnectionStatus status;
+  gint cid;
+
+  self = MM_BROADBAND_BEARER_FM350GL(g_task_get_source_object(task));
+
+  response = mm_base_modem_at_command_finish(modem, res, &error);
+  if (!response)
+  {
+    g_prefix_error(&error, "Couldn't check current list of active PDP contexts: ");
+    g_task_return_error(task, error);
+    g_object_unref(task);
+    return;
+  }
+
+  pdp_active_list = mm_3gpp_parse_cgact_read_response(response, &error);
+  if (error)
+  {
+    g_task_return_error(task, error);
+    g_object_unref(task);
+    return;
+  }
+
+  cid = mm_base_bearer_get_profile_id(MM_BASE_BEARER(self));
+
+  /* Default: cid not found in the list at all -> treat as disconnected,
+   * instead of the generic implementation's "shouldn't happen" error. */
+  status = MM_BEARER_CONNECTION_STATUS_DISCONNECTED;
+  for (l = pdp_active_list; l; l = g_list_next(l))
+  {
+    MM3gppPdpContextActive *pdp_active = (MM3gppPdpContextActive *)(l->data);
+    if (pdp_active->cid == (guint)cid)
+    {
+      status = (pdp_active->active ? MM_BEARER_CONNECTION_STATUS_CONNECTED
+                                    : MM_BEARER_CONNECTION_STATUS_DISCONNECTED);
+      break;
+    }
+  }
+  mm_3gpp_pdp_context_active_list_free(pdp_active_list);
+
+  g_task_return_int(task, (gssize)status);
+  g_object_unref(task);
+}
+
+static void
+load_connection_status(MMBaseBearer *self,
+                       GAsyncReadyCallback callback,
+                       gpointer user_data)
+{
+  GTask *task;
+  MMBaseModem *modem = NULL;
+  MMIfacePortAt *port;
+  gint cid;
+
+  task = g_task_new(self, NULL, callback, user_data);
+
+  cid = mm_base_bearer_get_profile_id(self);
+  if (cid == MM_3GPP_PROFILE_ID_UNKNOWN)
+  {
+    g_task_return_new_error(task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                            "Couldn't load connection status: cid not defined");
+    g_object_unref(task);
+    return;
+  }
+
+  g_object_get(self, MM_BASE_BEARER_MODEM, &modem, NULL);
+
+  port = mm_base_modem_peek_best_at_port(modem, NULL);
+  if (!port)
+  {
+    g_task_return_new_error(task, MM_CORE_ERROR, MM_CORE_ERROR_UNSUPPORTED,
+                            "Couldn't load connection status: no control port available");
+    g_object_unref(task);
+    g_object_unref(modem);
+    return;
+  }
+
+  mm_base_modem_at_command_full(modem, port, "+CGACT?", 3,
+                                FALSE, FALSE, NULL,
+                                (GAsyncReadyCallback)load_connection_status_ready, task);
+  g_object_unref(modem);
+}
+
+static MMBearerConnectionStatus
+load_connection_status_finish(MMBaseBearer *self,
+                              GAsyncResult *res,
+                              GError **error)
+{
+  GError *inner_error = NULL;
+  gssize value;
+
+  value = g_task_propagate_int(G_TASK(res), &inner_error);
+  if (inner_error)
+  {
+    g_propagate_error(error, inner_error);
+    return MM_BEARER_CONNECTION_STATUS_UNKNOWN;
+  }
+  return (MMBearerConnectionStatus)value;
+}
