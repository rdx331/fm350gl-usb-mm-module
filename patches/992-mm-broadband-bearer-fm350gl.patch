+/*
+ * The FM350-GL reports network-initiated session teardown as
+ * "+CGEV: EPS PDN DEACT", which is a Fibocom-specific variant not
+ * covered by the standard 3GPP +CGEV vocabulary ModemManager's generic
+ * broadband modem code parses (it only recognizes "NW PDN DEACT" /
+ * "ME PDN DEACT" and similar). Because of that, a disconnect on this
+ * modem was never reported up to the bearer, so nothing above
+ * ModemManager (netifd, NetworkManager, etc.) ever saw it happen and
+ * could redial. This handler is prepended on the primary port for the
+ * lifetime of the connection and reports the disconnection directly
+ * to this bearer as soon as the URC is seen, so upstream connection
+ * managers get a timely, correct "disconnected" signal to act on.
+ */
+static void
+fm350gl_cgev_disconnect_received(MMPortSerialAt *port,
+                                 GMatchInfo *match_info,
+                                 MMBroadbandBearerFM350GL *self)
+{
+  gchar *reason = g_match_info_fetch(match_info, 1);
+
+  mm_obj_msg(self, "network-initiated PDP deactivation detected (+CGEV: %s)",
+             reason ? reason : "unknown");
+  g_free(reason);
+
+  /* Avoid double-reporting if we're already tearing the bearer down
+   * ourselves (e.g. this URC arrives right as disconnect_3gpp runs). */
+  if (mm_base_bearer_get_status(MM_BASE_BEARER(self)) == MM_BEARER_STATUS_CONNECTED)
+  {
+    mm_base_bearer_report_connection_status(MM_BASE_BEARER(self),
+                                            MM_BEARER_CONNECTION_STATUS_DISCONNECTED);
+  }
+}
+
+static void
+setup_cgev_disconnect_detection(MMBroadbandBearerFM350GL *self,
+                                MMPortSerialAt *primary)
+{
+  GRegex *regex;
+
+  g_assert(primary != NULL);
+  regex = g_regex_new(
+      "\\r\\n\\+CGEV:\\s*((?:EPS|NW|ME) PDN DEACT)[^\\r\\n]*\\r\\n",
+      G_REGEX_RAW, 0, NULL);
+  mm_port_serial_at_add_unsolicited_msg_handler(
+      primary, regex,
+      (MMPortSerialAtUnsolicitedMsgFn)fm350gl_cgev_disconnect_received,
+      self, NULL);
+  g_regex_unref(regex);
+}
+
+static void
+teardown_cgev_disconnect_detection(MMBroadbandBearerFM350GL *self,
+                                   MMPortSerialAt *primary)
+{
+  GRegex *regex;
+
+  if (!primary)
+  {
+    return;
+  }
+  regex = g_regex_new(
+      "\\r\\n\\+CGEV:\\s*((?:EPS|NW|ME) PDN DEACT)[^\\r\\n]*\\r\\n",
+      G_REGEX_RAW, 0, NULL);
+  mm_port_serial_at_add_unsolicited_msg_handler(primary, regex, NULL, NULL, NULL);
+  g_regex_unref(regex);
+}
